<?xml version="1.0" encoding="UTF-8"?>
<!--
  Messaging Session record page using Enhanced Conversation (scrt:conversationBody).
  The default page carries the older Conversation component, which stays empty for
  bring-your-own-channel sessions.

  hideConversationHistory is the "Limit conversation history" checkbox in the Lightning App Builder.
-->
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>force:highlightsPanel</componentName>
                <identifier>force_highlightsPanel</identifier>
            </componentInstance>
        </itemInstances>
        <name>header</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>hideConversationHistory</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentName>scrt:conversationBody</componentName>
                <identifier>scrt_conversationBody</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentName>force:detailPanel</componentName>
                <identifier>force_detailPanel</identifier>
            </componentInstance>
        </itemInstances>
        <name>sidebar</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Messaging Session Record Page</masterLabel>
    <sobjectType>MessagingSession</sobjectType>
    <template>
        <name>flexipage:recordHomeTemplateDesktop</name>
    </template>
    <type>RecordPage</type>
</FlexiPage>
