{
  "name": "sf-byoc-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Creates a Salesforce scratch org, installs a Partner Messaging (bring-your-own-channel) managed package, configures the org for it, and proves the chat round trip with the external messaging system.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx src/cli.ts",
    "setup:headed": "tsx src/cli.ts --headed",
    "connect": "tsx src/cli.ts --connect",
    "verify": "tsx src/cli.ts --only=verify",
    "delete-org": "tsx src/cli.ts --delete",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium",
    "configure": "tsx tools/config-server.ts",
    "env-example": "tsx tools/config-server.ts --write-env-example"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
